# Minimal settings for docker compose -f docker-compose.fips.yml up -d

# Almond
PUBLIC_URL=http://<this-node-npub>.fips:3000
UPSTREAM_MODE=proxy
UPSTREAM_SERVERS=

# FIPS identity. Generate/provide your own key; do not reuse this placeholder.
FIPS_NSEC=nsec1...

# Optional direct peer. Leave empty if this node accepts inbound peers only or
# if you mount a full FIPS config.
FIPS_PEER_NPUB=
FIPS_PEER_ADDR=
FIPS_PEER_ALIAS=gateway
FIPS_PEER_TRANSPORT=udp

# Preferred multi-peer format (overrides single-peer variables when non-empty):
# one peer per line: npub,addr[,alias[,transport]]
# Example:
# FIPS_PEERS=npub1aaa...,203.0.113.10:2121,gateway-a,udp
# npub1bbb...,198.51.100.20:2121,gateway-b,udp
FIPS_PEERS=

# Optional .fips aliases. Format is one "name npub1..." mapping per line.
# Example:
# FIPS_HOSTS=media-cache npub1upstream...
FIPS_HOSTS=
