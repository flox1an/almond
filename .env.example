# Almond configuration template
#
# Copy this file to .env (auto-loaded from the working directory) or pass it
# explicitly with `almond --config /etc/almond/almond.env`, then set
# ALMOND_PUBLIC_URL and the sections you use.
# Every line can also be given as a CLI flag: drop the ALMOND_ prefix,
# lower-case the name and replace _ with - (ALMOND_UPLOAD_ACCESS=wot is
# `--upload-access wot`). Precedence: CLI flag > environment > this file > default.
# Values are parsed at startup; invalid values are startup errors. An empty value
# (ALMOND_X=) behaves exactly like an unset one.
# Formats: durations 30s, 5m, 24h, 7d; sizes 512KiB, 100MiB, 2GiB (IEC units only);
# booleans true/false; lists are comma-separated and must not contain
# whitespace-sensitive secrets.
# Pre-0.5 names (BIND_ADDR, MAX_BLOB_SIZE_MB, ...) still work as deprecated
# aliases with a startup warning; see "Migrating from pre-0.5 names" in README.md.

# -----------------------------------------------------------------------------
# Network and public identity
# -----------------------------------------------------------------------------
# Address Almond listens on. Use 0.0.0.0:3000 in a container or behind a proxy.
ALMOND_BIND_ADDR=127.0.0.1:3000
# Public origin used when Almond creates blob descriptors. No trailing slash.
ALMOND_PUBLIC_URL=http://127.0.0.1:3000

# Browser API CORS. Blob GET/HEAD stays public; discovery and metrics responses
# allow only these exact comma-separated origins. Leave unset to deny cross-origin API reads.
# ALMOND_CORS_ORIGINS=https://app.example.com,https://admin.example.com

# -----------------------------------------------------------------------------
# HTTPS / TLS
# -----------------------------------------------------------------------------
# Set true when Almond terminates TLS itself. Leave false behind a TLS proxy.
ALMOND_TLS_ENABLED=false
# Existing certificate and private-key paths. With ALMOND_TLS_SELF_SIGNED=true,
# missing files are replaced by a self-signed pair; use only for development.
ALMOND_TLS_CERT=./cert.pem
ALMOND_TLS_KEY=./key.pem
ALMOND_TLS_SELF_SIGNED=false

# -----------------------------------------------------------------------------
# Local storage and retention
# -----------------------------------------------------------------------------
# Storage root. Almond creates these managed children automatically:
#   uploads/        authorized uploads, explicit mirrors, and HLS mirrors
#   upstream-cache/ transparent proxy and redirect-and-cache fills
#   temp/           incomplete uploads and in-flight downloads; never indexed
#   quarantine/     BUD-09 quarantined blobs; never indexed
#   reports/        BUD-09 report audit records, one JSON per event; never indexed
# Existing legacy <hex>/<hex>/<hash> trees migrate into uploads/ at startup by
# rename, without copying blob bodies. Keep this root on one filesystem.
ALMOND_STORAGE_PATH=./files

# Aggregate completed-blob limits across uploads and upstream-cache; 0 = unlimited.
# Size takes a unit; file count is a number of completed blobs.
ALMOND_STORAGE_MAX_SIZE=0
ALMOND_STORAGE_MAX_FILES=0
# Expiry and capacity cleanup cadence. Must be greater than zero.
ALMOND_CLEANUP_INTERVAL=30s

# Uploaded content only. Includes explicit and HLS mirrors. 0 disables age expiry.
# X-Expiration (Almond extension) may shorten retention but never extend
# ALMOND_UPLOAD_MAX_AGE. Limit changes apply to existing uploads; the resulting
# cleanup deadline is emitted as Sunset.
ALMOND_UPLOAD_MAX_AGE=0
# Transparent upstream cache only. 0 disables cache TTL. Requests do not extend it.
ALMOND_UPSTREAM_CACHE_TTL=1d
# Under capacity pressure, oldest upstream-cache entries are evicted before uploads.

# Admission limits, independent of retention quotas.
# ALMOND_BLOB_MAX_SIZE is an absolute per-blob limit; ALMOND_STORAGE_MIN_FREE
# returns HTTP 507 when breached.
ALMOND_BLOB_MAX_SIZE=500MiB
ALMOND_STORAGE_MIN_FREE=256MiB

# Optional S3-compatible storage for uploads and explicit mirrors. Set all four
# values together. S3 blobs remain Upload-origin; upstream cache stays local.
# ALMOND_S3_ENDPOINT=https://<endpoint>
# ALMOND_S3_BUCKET=<bucket-name>
# ALMOND_S3_ACCESS_KEY_ID=<access-key-id>
# ALMOND_S3_SECRET_ACCESS_KEY=<secret-access-key>

# -----------------------------------------------------------------------------
# Uploads, mirrors, and authorization
# -----------------------------------------------------------------------------
# Access modes: off, wot, dvm, public.
ALMOND_UPLOAD_ACCESS=public
ALMOND_MIRROR_ACCESS=public
# /list and the homepage use booleans, not access modes.
ALMOND_LIST_ENABLED=true
ALMOND_HOMEPAGE_ENABLED=true
# Allows an authorized request to supply a custom upstream origin.
ALMOND_CUSTOM_ORIGIN_ACCESS=off

# Comma-separated allowed npubs. When non-empty, public upload/mirror access is
# restricted to this list. Leave unset for signature-only public access.
# An invalid npub is a startup error.
# ALMOND_ALLOWED_NPUBS=npub1...,npub1...
# Authorization token lifetime cap and tolerated clock skew. The cap must be
# greater than zero; 24h matches the reference client's 1-hour default with headroom.
ALMOND_AUTH_MAX_TTL=24h
ALMOND_AUTH_CLOCK_SKEW=30s
# Require authorization events to contain a matching server tag.
ALMOND_AUTH_REQUIRE_SERVER_TAG=false

# Resumable upload controls. ALMOND_CHUNK_MAX_SIZE must not exceed ALMOND_BLOB_MAX_SIZE.
ALMOND_CHUNK_MAX_SIZE=100MiB
ALMOND_CHUNK_SESSION_TIMEOUT=30m
ALMOND_CHUNK_MAX_SESSIONS=128
ALMOND_CHUNK_MAX_SESSIONS_PER_PUBKEY=8
# Parallel segment fetches for an explicit HLS mirror.
ALMOND_HLS_MIRROR_CONCURRENCY=4

# -----------------------------------------------------------------------------
# Upstream reads and transparent caching
# -----------------------------------------------------------------------------
# Comma-separated trusted upstream Blossom origins. Leave unset to disable this source.
# ALMOND_UPSTREAM_SERVERS=https://cdn.satellite.earth,https://blossom.primal.net
# proxy streams while storing a transparent cache copy; redirect returns a 302;
# redirect-and-cache returns a 302 and fills the cache in the background.
ALMOND_UPSTREAM_MODE=proxy
# Maximum body accepted from one transparent upstream fetch. Larger blobs are
# proxied through to the client and not cached.
ALMOND_UPSTREAM_MAX_DOWNLOAD_SIZE=100MiB

# -----------------------------------------------------------------------------
# Reports, metrics, and optional serving
# -----------------------------------------------------------------------------
# Access modes: off, wot, dvm, public.
ALMOND_REPORT_ACCESS=off
# quarantine moves a local blob to quarantine/ and makes its hash a permanent
# upload denylist entry; delete removes the current copy.
ALMOND_REPORT_ACTION=quarantine

# /metrics is disabled until this bearer token is set. Keep it off public networks.
# ALMOND_METRICS_TOKEN=replace-with-a-long-random-secret

# Optional directory of static files served alongside blobs. Almond rebuilds its
# SHA-256 manifest at the configured interval.
# ALMOND_SERVE_FILES_PATH=./public
# Fallback directory for the manifest when ALMOND_SERVE_FILES_PATH is not writable.
# Defaults to /tmp, which is always writable and is regenerated on each refresh.
# ALMOND_SERVE_FILES_MANIFEST_DIR=/tmp
ALMOND_SERVE_FILES_MANIFEST_NAME=manifest-sha256.txt
ALMOND_SERVE_FILES_REFRESH_INTERVAL=1h

# -----------------------------------------------------------------------------
# Paid operations (Cashu / BUD-07)
# -----------------------------------------------------------------------------
# Comma-separated list of paid operations: upload, mirror, download.
# Leave unset for no paid operations.
# ALMOND_CASHU_PAID=upload,mirror
# Sats per MiB.
ALMOND_CASHU_PRICE_PER_MIB=1
# Exactly one mint URL; required when ALMOND_CASHU_PAID is set.
# ALMOND_CASHU_MINT=https://mint.example.com
ALMOND_CASHU_WALLET_PATH=./cashu_wallet.db

# -----------------------------------------------------------------------------
# Nostr discovery and filters
# -----------------------------------------------------------------------------
# How long an author's Blossom server list is cached locally.
ALMOND_SERVER_LIST_CACHE_TTL=24h
# BUD-11 filter algorithm: bloom, binary-fuse-8, binary-fuse-16, binary-fuse-32.
ALMOND_FILTER_ALGORITHM=binary-fuse-16

# Needed only when ALMOND_UPLOAD_ACCESS or ALMOND_MIRROR_ACCESS is dvm.
# ALMOND_DVM_KINDS=5207
# ALMOND_DVM_RELAYS=wss://nos.lol,wss://relay.primal.net
ALMOND_DVM_REFRESH_INTERVAL=5m
