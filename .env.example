# Almond configuration template
#
# Copy this file to .env, then set PUBLIC_URL and the sections you use.
# Values are parsed at startup. Leave commented optional settings unset unless
# their feature is enabled. Comma-separated lists must not contain whitespace-sensitive secrets.

# -----------------------------------------------------------------------------
# Network and public identity
# -----------------------------------------------------------------------------
# Address Almond listens on. Use 0.0.0.0:3000 in a container or behind a proxy.
BIND_ADDR=127.0.0.1:3000
# Public origin used when Almond creates blob descriptors. No trailing slash.
PUBLIC_URL=http://127.0.0.1:3000

# Browser API CORS. Blob GET/HEAD stays public; discovery and metrics responses
# allow only these exact comma-separated origins. Leave unset to deny cross-origin API reads.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# -----------------------------------------------------------------------------
# HTTPS / TLS
# -----------------------------------------------------------------------------
# Set true when Almond terminates TLS itself. Leave false behind a TLS proxy.
ENABLE_HTTPS=false
# Existing certificate and private-key paths. With TLS_AUTO_GENERATE=true,
# missing files are replaced by a self-signed pair; use only for development.
TLS_CERT_PATH=./cert.pem
TLS_KEY_PATH=./key.pem
TLS_AUTO_GENERATE=true

# -----------------------------------------------------------------------------
# Local storage and retention
# -----------------------------------------------------------------------------
# Storage root. Almond creates these managed children automatically:
#   uploads/        authorized uploads, explicit mirrors, and HLS mirrors
#   upstream-cache/ transparent proxy and redirect_and_cache fills
#   temp/           incomplete uploads and in-flight downloads; never indexed
#   quarantine/     BUD-09 quarantined blobs; never indexed
# Existing legacy <hex>/<hex>/<hash> trees migrate into uploads/ at startup by
# rename, without copying blob bodies. Keep this root on one filesystem.
STORAGE_PATH=./files

# Aggregate completed-blob limits across uploads and upstream-cache.
# Size is in MiB; file count is a number of completed blobs.
MAX_TOTAL_SIZE=99999
MAX_TOTAL_FILES=99999999
# Expiry and capacity cleanup cadence. Must be greater than zero.
CLEANUP_INTERVAL_SECS=30

# Uploaded content only. Includes explicit and HLS mirrors. 0 disables age expiry.
# X-Expiration may shorten retention but never extend MAX_FILE_AGE_DAYS; the
# effective deadline is persisted and emitted as a Sunset response header.
MAX_FILE_AGE_DAYS=0
# Transparent upstream cache only. 0 disables cache TTL. Requests do not extend it.
MAX_UPSTREAM_CACHE_TTL_DAYS=1
# Under capacity pressure, oldest upstream-cache entries are evicted before uploads.

# Admission limits, independent of retention quotas.
# MAX_BLOB_SIZE_MB is an absolute per-blob limit; MIN_FREE_DISK_MB returns HTTP 507 when breached.
MAX_BLOB_SIZE_MB=100
MIN_FREE_DISK_MB=256

# Optional S3-compatible storage for uploads and explicit mirrors. Set all four
# values together. S3 blobs remain Upload-origin; upstream cache stays local.
# ALMOND_S3_ENDPOINT=https://<endpoint>
# ALMOND_S3_BUCKET=<bucket-name>
# ALMOND_S3_ACCESS_KEY_ID=<access-key-id>
# ALMOND_S3_SECRET_ACCESS_KEY=<secret-access-key>

# -----------------------------------------------------------------------------
# Uploads, mirrors, and authorization
# -----------------------------------------------------------------------------
# Feature modes: off, wot, dvm, public.
FEATURE_UPLOAD_ENABLED=public
FEATURE_MIRROR_ENABLED=public
# /list and the homepage use booleans, not feature modes.
FEATURE_LIST_ENABLED=true
FEATURE_HOMEPAGE_ENABLED=true
# Allows an authorized request to supply a custom upstream origin.
FEATURE_CUSTOM_UPSTREAM_ORIGIN_ENABLED=off

# Comma-separated allowed npubs. When non-empty, public upload/mirror access is
# restricted to this list. Leave unset for signature-only public access.
# ALLOWED_NPUBS=npub1...,npub1...
# Authorization token lifetime cap and tolerated clock skew, in seconds.
# Set AUTH_MAX_TTL_SECS=0 to disable the cap (spec-pure, honors the token's own
# expiration). 86400 matches the reference client's 1-hour default with headroom.
AUTH_MAX_TTL_SECS=86400
AUTH_CLOCK_SKEW_SECS=30
# Require authorization events to contain a matching server tag.
AUTH_REQUIRE_SERVER_TAG=false

# Resumable upload controls. MAX_CHUNK_SIZE_MB must not exceed MAX_BLOB_SIZE_MB.
MAX_CHUNK_SIZE_MB=100
CHUNK_CLEANUP_TIMEOUT_MINUTES=30
MAX_CHUNK_UPLOAD_SESSIONS=128
MAX_CHUNK_UPLOAD_SESSIONS_PER_PUBKEY=8
# Parallel segment fetches for an explicit HLS mirror.
HLS_MIRROR_CONCURRENCY=4

# -----------------------------------------------------------------------------
# Upstream reads and transparent caching
# -----------------------------------------------------------------------------
# Comma-separated trusted upstream Blossom origins. Leave unset to disable this source.
# UPSTREAM_SERVERS=https://cdn.satellite.earth,https://blossom.primal.net
# proxy streams while storing a transparent cache copy; redirect returns a 302;
# redirect_and_cache returns a 302 and fills the cache in the background.
UPSTREAM_MODE=proxy
# Maximum body accepted from one transparent upstream fetch.
MAX_UPSTREAM_DOWNLOAD_SIZE_MB=100

# -----------------------------------------------------------------------------
# Reports, metrics, and optional serving
# -----------------------------------------------------------------------------
# Feature modes: off, wot, dvm, public.
FEATURE_REPORT_ENABLED=off
# quarantine moves a local blob to quarantine/ and makes its hash a permanent
# upload denylist entry; delete removes the current copy.
REPORT_ACTION=quarantine

# /metrics is disabled until this bearer token is set. Keep it off public networks.
# METRICS_BEARER_TOKEN=replace-with-a-long-random-secret

# Optional directory of static files served alongside blobs. Almond rebuilds its
# SHA-256 manifest at the configured interval.
# SERVE_FILES_PATH=./public
# Fallback directory for the manifest when SERVE_FILES_PATH is not writable.
# Defaults to /tmp, which is always writable and is regenerated on each refresh.
# SERVE_FILES_MANIFEST_DIR=/tmp
SERVE_FILES_MANIFEST_NAME=manifest-sha256.txt
SERVE_FILES_REFRESH_INTERVAL_SECS=3600

# -----------------------------------------------------------------------------
# Paid operations (Cashu / BUD-07)
# -----------------------------------------------------------------------------
# Paid feature switches accept only "on"; any other value disables the feature.
FEATURE_PAID_UPLOAD=off
FEATURE_PAID_MIRROR=off
FEATURE_PAID_DOWNLOAD=off
# Sats per MiB.
CASHU_PRICE_PER_MB=1
# Exactly one mint is required when any paid feature is on.
# CASHU_ACCEPTED_MINTS=https://mint.example.com
CASHU_WALLET_PATH=./cashu_wallet.db

# -----------------------------------------------------------------------------
# Nostr discovery, filters, and optional P2P serving
# -----------------------------------------------------------------------------
# How long an author's Blossom server list is cached locally.
BLOSSOM_SERVER_LIST_CACHE_TTL_HOURS=24
# BUD-11 filter algorithm: bloom, binary-fuse-8, binary-fuse-16, binary-fuse-32.
FILTER_ALGORITHM=binary-fuse-16

# Needed only when FEATURE_UPLOAD_ENABLED or FEATURE_MIRROR_ENABLED is dvm.
# DVM_ALLOWED_KINDS=5207
# DVM_RELAYS=wss://nos.lol,wss://relay.primal.net
DVM_REFRESH_INTERVAL_MINS=5

# Hashtree P2P serves hashes already local to Almond; it is not an HTTP upstream.
FEATURE_P2P_SERVE_ENABLED=false
# P2P_NSEC=nsec1...
# P2P_RELAYS=wss://relay.example.com
# P2P_STUN_SERVERS=stun:stun.l.google.com:19302
P2P_REQUEST_TIMEOUT_MS=10000
P2P_HELLO_INTERVAL_MS=3000
P2P_DEBUG=false
